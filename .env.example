# Accora — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Application
# Set ACCORA_DEBUG=false for production deployments (prevents stack trace disclosure)
ACCORA_DEBUG=false

# Demo Mode: Set ACCORA_DEMO_MODE=false in production to disable demo-account seeding
# and make POST /api/v1/auth/demo-login return 404 Not Found.
# Set to true only in local development / evaluation environments.
ACCORA_DEMO_MODE=false

# CORS Configuration
# Comma-separated list or JSON array of allowed origins for the backend.
# In production, set this to your deployed frontend domain on Vercel:
# ACCORA_CORS_ORIGINS=https://accora.vercel.app
# For local development:
# ACCORA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ACCORA_CORS_ORIGINS=["http://localhost:5173"]

# Database Persistence
# In local development: relative path defaults to "accora.db" inside the backend folder.
# In production on Render: use an absolute persistent disk path, e.g. /var/data/accora.db.
# Ensure a persistent disk (e.g. 1 GB mounted at /var/data) is attached in Render.
ACCORA_DATABASE_PATH=/var/data/accora.db

# AI Provider: Keep set to "mock" until real provider integration is implemented.
ACCORA_AI_PROVIDER=mock

# Alibaba Cloud AI (future placeholder; leave as mock for now)
ACCORA_ALIBABA_API_KEY=your_api_key_here
ACCORA_ALIBABA_MODEL_ID=qwen-turbo
ACCORA_ALIBABA_ENDPOINT=your_endpoint_url_here

# Frontend Configuration (set on Vercel / frontend deployment):
# VITE_API_URL=https://<your-render-backend-name>.onrender.com
