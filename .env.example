# Accora — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Application
ACCORA_DEBUG=true
ACCORA_DEMO_MODE=true

# CORS (comma-separated origins)
# ACCORA_CORS_ORIGINS=["http://localhost:5173"]

# AI Provider: "mock" for development, "alibaba" for production
ACCORA_AI_PROVIDER=mock

# Alibaba Cloud AI (required when ACCORA_AI_PROVIDER=alibaba)
ACCORA_ALIBABA_API_KEY=your_api_key_here
ACCORA_ALIBABA_MODEL_ID=qwen-turbo
ACCORA_ALIBABA_ENDPOINT=your_endpoint_url_here
